rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn() && 'role' in request.auth.token && request.auth.token.role in ["front-desk", "admin"];
    }

    function isAdmin() {
      return signedIn() && 'role' in request.auth.token && request.auth.token.role == "admin";
    }

    // PR-AUDIT (2026-10-20): the audio-routing audit stamp.
    //
    // `affectedKeys().hasOnly([...])` is a SUBSET check — it restricts
    // WHICH keys a write may touch, it does NOT require that a listed
    // key is present. The `audioRouting` contract
    // (`plan/features/INTERCOM-AUDIO-ROUTING.md` §D&L 46) requires the
    // companion `audioRoutingUpdatedAt` stamp on EVERY write that
    // changes `audioRouting`, so that pairing is enforced explicitly
    // here. A write that leaves `audioRouting` alone (e.g. the member
    // editing their own `fullName`) is unaffected.
    function audioRoutingStamped() {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return !changed.hasAny(["audioRouting"])
        || changed.hasAll(["audioRoutingUpdatedAt"]);
    }

    // Per RPT-2 (2026-10-21, re-confirmed 2026-10-27): an
    // incidental CHARGE cannot be added to a booking that has already
    // been checked out.
    //
    // The admin app writes a charge DIRECTLY to Firestore
    // (`addDoc(chargesRef, {...})` in `BookingsPage.tsx`), so no
    // server handler sits in the path — hiding the "Add charge"
    // button in `IncidentalChargeList.tsx` was the ONLY thing
    // stopping it. The 2026-10-21 QA pass proved the gap against
    // production: a client write after checkout SUCCEEDED (₱250 on a
    // checked-out booking).
    //
    // WHY IT MATTERS: a charge lands in the booking's folio, so one
    // added after checkout moves the settled balance of a stay whose
    // guest has already left — and the reconciliation's I08/I14
    // checks then see a booking whose books do not close.
    //
    // The rule is deliberately narrow. It refuses only a NEW charge
    // (`amount > 0`, `voidOf == null`) on a booking that is already
    // checked out. A VOID — the reversal of a charge made BEFORE
    // checkout — stays ALLOWED on a checked-out booking, because that
    // is exactly how the desk corrects the mistake once the guest has
    // left; blocking it would strand the error in the folio forever.
    //
    // The reservation-level charges rule applies the same check to
    // the booking the charge names (`request.resource.data.bookingId`),
    // because the admin app picks the parent with
    // `getSelectedChargeCollection()` and both rules are live paths.
    function chargeAllowedOnBooking(bookingId) {
      let booking = get(/databases/$(database)/documents/bookings/$(bookingId));
      return booking != null && booking.data.status != "checked-out";
    }

    match /rooms/{roomId} {
      allow read: if true;
      // Per W3.4 / `plan/features/ROOM-MANAGEMENT.md §Delete`: only
      // admins can hard-delete a room document. Front-desk can still
      // create, edit, and toggle active/blocked status.
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /roomPrivate/{roomId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /roomBlocks/{blockId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /staffInventoryHolds/{holdId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /roomDeletionAudit/{auditId} {
      allow read: if isStaff();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // Per OCT-C3 (2026-10-20, audit
    // `plan/project/AUDIT-OCTOBER-2026.md`): the BR-12 other
    // add-on CATALOG. The admin Settings tab (Other Add-Ons)
    // reads + writes this collection DIRECTLY from the browser
    // via the Firestore client SDK (`admin-app/src/pages/
    // SettingsPage.tsx` — `query(collection(db, "addOns"))`,
    // `setDoc`, `deleteDoc`), so it is subject to these rules.
    //
    // The collection shipped in BR-12 (2026-10-15) WITHOUT a
    // rule block, and Firestore denies unmatched paths by
    // default. Every admin read + write therefore failed with
    // PERMISSION_DENIED, and because each error was swallowed
    // the tab rendered its "No add-ons yet" empty state — the
    // admin could not see, price, enable/disable, create or
    // delete any other add-on, while the guest path (server
    // side, Admin SDK) kept selling the read-only pre-seed.
    //
    // The guest app never reads this collection directly: the
    // public catalog goes through `GET /api/bookings/addons/
    // config` (Admin SDK, rules not applied), so no public
    // read is granted here.
    match /addOns/{addOnId} {
      allow read: if isStaff();
      allow create, update, delete: if isAdmin();
    }

    // Per OCT-C3 (2026-10-20): the top-level settings-change
    // audit trail written by the admin app (`addDoc(collection
    // (db, "auditLogs"), ...)`). It shipped in BR-12.1 without a
    // rule block, so every audit row was rejected — the
    // `addons.create` / `addons.update` / `addons.delete`
    // actions were permanently lost.
    //
    // Append-only: staff may record a row, nobody may rewrite
    // or delete one. Reads are admin-only (the trail is a
    // settings-level audit surface, not a front-desk one).
    match /auditLogs/{auditId} {
      allow read: if isAdmin();
      allow create: if isStaff();
      allow update, delete: if false;
    }

    match /bookings/{bookingId} {
      allow read: if isStaff();
      allow create: if false;
      // Per MRB-01 (2026-08-02, per decision #159): the four
      // `reservation*` fields on a booking are server-assigned
      // projections of the parent `reservations/{id}` document.
      // The `affectedKeys().hasOnly([...])` allowlist below does
      // NOT list them, so any client write that touches
      // `reservationId` / `reservationRef` / `reservationPosition`
      // / `reservationRoomCount` is implicitly denied by omission.
      // (The pin test in
      // `firebase/tests/reservation-rules.emulator.test.ts` asserts
      // the implicit-deny contract — a future refactor that
      // accidentally widens the allowlist breaks the test.)
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "guestIdPhotoUrl",
          "guestRegistration",
          "breakfastSelections",
          "breakfastServed",
          "discountVerified",
          "discountVerifiedBy",
          "discountRejected",
          "notes",
          "specialRequests",
          // Per feat/staff-special-requests-capture (2026-08-21):
          // the staff write paths (drawer editor, walk-in
          // modal, calendar-create modal) stamp the
          // last-edit metadata in the same `updateDoc`
          // call. The fields are optional on the type so
          // pre-existing docs read without coercion; the
          // server endpoint stamps both as part of every
          // successful write.
          "specialRequestsUpdatedAt",
          "specialRequestsUpdatedBy",
          "handledBy",
          "updatedAt"
        ]);
      allow delete: if isAdmin();

      match /payments/{paymentId} {
        allow read: if isStaff();
        allow create: if false; // Server-authoritative payment/refund APIs only.
        allow update, delete: if false;
      }

      match /charges/{chargeId} {
        allow read: if isStaff();
        allow create: if isStaff()
          && request.resource.data.keys().hasOnly(["label", "amount", "category", "note", "addedBy", "addedAt", "voidOf"])
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 120
          && request.resource.data.amount is number
          && request.resource.data.amount != 0
          && request.resource.data.amount <= 1000000
          && request.resource.data.amount >= -1000000
          && request.resource.data.category in ["late-checkout", "early-checkin", "extra-person", "damage", "laundry", "other"]
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 300
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.addedAt == request.time
          && (
            (request.resource.data.amount > 0
              && request.resource.data.voidOf == null
              // Per RPT-2: a NEW charge needs a booking that has not
              // been checked out. A VOID (the second branch) is
              // deliberately NOT subject to this check — reversing a
              // charge made before checkout is how the desk corrects
              // the mistake after the guest has left.
              && chargeAllowedOnBooking(bookingId))
            || (
              request.resource.data.amount < 0
              && request.resource.data.voidOf is string
              && chargeId == "void-" + request.resource.data.voidOf
              && get(/databases/$(database)/documents/bookings/$(bookingId)/charges/$(request.resource.data.voidOf)).data.amount == -request.resource.data.amount
            )
          );
        allow update, delete: if false;
      }
    }

    // Per W1.4 / decision #49 / audit S2.3: anonymized booking audit
    // records written by /api/members/delete-account. Staff can read
    // for accounting / RA 11862 compliance; clients cannot write or
    // read; server-side only.
    match /bookings/audit/records/{auditId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /financeIntegrityRepairs/{repairId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Per MRB-01 (2026-08-02, per decision #159): the reservation
    // header. Server-authoritative create / update / delete — the
    // public ref, lead booker, source / corporate context, payment
    // state, voucher / member discount, consent, and group totals
    // are all written through Admin SDK transactions. Staff can
    // read for the admin booking drawer; guests never have direct
    // access (the public lookup resolves the reservation via the
    // pre-allocated `reservationId` + the verified email / token
    // credential, gated by /api/bookings/lookup).
    //
    // Subcollections mirror the booking's money-shape so MRB-04's
    // folio migration (payments + charges + refunds on the
    // reservation) and MRB-07's refund-state machine can land
    // without a second rules change. The `payments` and `refunds`
    // subcollections are server-only (no client create — same shape
    // as the existing booking payments rule); the `charges`
    // subcollection allows staff direct write (same shape as the
    // existing booking charges rule, with the per-creator + bounds
    // + void semantics).
    match /reservations/{reservationId} {
      allow read: if isStaff();
      allow write: if false;  // Server-authoritative; Admin SDK only.

      match /payments/{paymentId} {
        allow read: if isStaff();
        allow create: if false;  // Server-authoritative payment/refund APIs only.
        allow update, delete: if false;
      }

      // Per MRB-04 Phase 2.x (2026-08-02, per decision #159): the
      // canonical refund source for new reservations. The
      // `handleAddRefund` writer only writes to `refunds/`; the
      // helper `getReservationFolioSummary` reads BOTH `payments/`
      // (for any negative-amount entries — belt-and-suspenders) AND
      // `refunds/` (canonical). Server-only: refunds are admin-only
      // and require a `client-preallocated refundId` for CRL-01
      // idempotency. Same shape as the `payments/` subcollection —
      // no client create/update/delete; staff read.
      match /refunds/{refundId} {
        allow read: if isStaff();
        allow create: if false;  // Server-authoritative refund APIs only.
        allow update, delete: if false;
      }

      match /charges/{chargeId} {
        allow read: if isStaff();
        allow create: if isStaff()
          && request.resource.data.keys().hasOnly(["label", "amount", "category", "note", "addedBy", "addedAt", "voidOf", "bookingId"])
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 120
          && request.resource.data.amount is number
          && request.resource.data.amount != 0
          && request.resource.data.amount <= 1000000
          && request.resource.data.amount >= -1000000
          && request.resource.data.category in ["late-checkout", "early-checkin", "extra-person", "damage", "laundry", "other"]
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 300
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.addedAt == request.time
          && request.resource.data.bookingId is string
          && request.resource.data.bookingId.size() > 0
          && request.resource.data.bookingId.size() <= 128
          && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.reservationId == reservationId
          && (
            (request.resource.data.amount > 0
              && request.resource.data.voidOf == null
              // Per RPT-2: the same post-checkout guard, applied to
              // the booking this charge names. The admin app picks
              // the parent with `getSelectedChargeCollection()`, so
              // this rule is a live path too.
              && chargeAllowedOnBooking(request.resource.data.bookingId))
            || (
              request.resource.data.amount < 0
              && request.resource.data.voidOf is string
              && chargeId == "void-" + request.resource.data.voidOf
              && get(/databases/$(database)/documents/reservations/$(reservationId)/charges/$(request.resource.data.voidOf)).data.amount == -request.resource.data.amount
              && get(/databases/$(database)/documents/reservations/$(reservationId)/charges/$(request.resource.data.voidOf)).data.bookingId == request.resource.data.bookingId
            )
          );
        allow update, delete: if false;
      }
    }

    // FD-02 (E2E audit 2026-07-17): signed-in users may update only
    // legitimate self-service profile fields. The `role`, `isActive`,
    // and staff-audit fields are reserved for admin/server writes.
    // Admin SDK staff provisioning and valid Spark Rewards profile
    // editing (fullName, phone, photoUrl) are preserved.
    //
    // PR-AUDIT (2026-10-20): the `audioRoutingStamped()` conjunct
    // enforces the §D&L 46 audit-stamp pairing that `hasOnly()` alone
    // could not express. See the function's comment above.
    match /guests/{userId} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == userId);
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "fullName",
            "displayName",
            "phone",
            "photoUrl",
            "address",
            "dateOfBirth",
            "emergencyContact",
            "preferences",
            "audioRouting",
            "audioRoutingUpdatedAt",
            "updatedAt"
          ])
          && audioRoutingStamped()
        );
      allow delete: if isAdmin();
    }

    match /members/{userId} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == userId);
      allow create: if false;
      // Per Spark Rewards audit 2026-07-18 MED-1: the staff-side
      // update is restricted to a field allowlist that does NOT
      // include `rewardsPoints` (or other financial fields). All
      // balance mutations are server-side via the Admin SDK now:
      //   - /api/members/redeem-points (staff)
      //   - /api/members/undo-redemption (admin)
      //   - /api/members/manual-adjust (admin, MED-1 fix)
      //   - checkout-time earn via the existing API routes
      // The `rewardsPoints` field is no longer writable from any
      // client. The member self-update branch (fullName, phone,
      // photoUrl) is unchanged.
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "isActive",
            "isMember",
            "tier",
            "memberSince",
            "memberNumber",
            "notes",
            "handledBy",
            "updatedAt"
          ])
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["fullName", "phone", "photoUrl", "updatedAt"])
        );
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);

      match /pointsHistory/{entryId} {
        // Per MED-1: history writes happen inside the server
        // transaction (Admin SDK bypasses rules), so the staff
        // `allow create` is no longer needed. We still permit
        // `isStaff()` here as a defense-in-depth fallback — if a
        // future migration ever needs to backfill from the
        // client, the path exists — but the only live writer in
        // the codebase is the server. The integrity invariant
        // (balance == sum(history)) is enforced at the
        // server-transaction boundary, not here.
        allow read: if isStaff() || (signedIn() && request.auth.uid == userId);
        allow create: if isStaff();
        allow update, delete: if false;
      }
    }

    // Per F09 / SEC-6 (2026-10-22, P2 revenue leak): the `settings`
    // collection was `allow read: if true`, so EVERY document in it
    // was world-readable straight from an unauthenticated browser —
    // including `settings/hotelConfig`, which carries the hotel's
    // NEGOTIATED corporate rate ladder (`roomTypes[].corporateRate`)
    // and the bank details of the payment methods (the
    // `accountNumber` of a method the admin hid from the corporate
    // surface with `showInCorporate: false`), plus `settings/rooms`.
    //
    // The collection is now staff-read / admin-write. The guest site
    // reads the hotel's PUBLIC content through the public projection
    // served by `GET /api/public/hotel-config`
    // (`guest-app/server/handlers/public-config.ts`) — the server
    // reads the document with the Admin SDK and projects an explicit
    // allow-list that contains no corporate rate and no hidden bank
    // detail.
    //
    // New `settings/*` documents are therefore staff-only by
    // DEFAULT: a doc only becomes publicly readable by being listed
    // explicitly in the blocks below.
    match /settings/{documentId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // The marketing / published-content documents the guest site
    // reads directly. Each one is a public artefact by design — page
    // copy, the published SEO card, the rewards tiers, and the
    // breakfast menu. None of them carries negotiated pricing, a bank
    // detail, PII, or a staff-only field.
    match /settings/websiteContent { allow read: if true; }
    match /settings/breakfastConfig { allow read: if true; }
    match /settings/rewardsConfig { allow read: if true; }
    match /settings/seo { allow read: if true; }

    // Per PR-AUDIT-B1 (2026-10-20): the breakfast-config change
    // log lives in a SUBCOLLECTION of `settings/breakfastConfig`
    // (`SettingsPage.tsx` — `collection(db, "settings",
    // "breakfastConfig", "breakfastConfigChangeLog")`).
    // The `match /settings/{documentId}` block above matches ONLY
    // the two-segment document — Firestore rules do NOT cascade
    // into subcollections — so every `addDoc` to the change log
    // was PERMISSION_DENIED for every role, admin included. The
    // client swallowed the rejection with a `console.warn`, so the
    // audit trail was silently lost behind a successful save toast.
    // This block closes the gap. Read is staff (the admin reports
    // surface it); write is admin, mirroring the parent doc.
    match /settings/{documentId}/breakfastConfigChangeLog/{auditId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /corporateInquiries/{inquiryId} {
      allow read, update: if isStaff();
      allow create: if isStaff();
      // Per F01-CORP (2026-10-22, P5 production QA): `delete` was
      // staff-wide. Nothing in the codebase deletes an inquiry
      // through a rules-governed write — the admin app only UPDATES
      // (`AdminContext.tsx` — `updateInquiryStatus`, `addInquiryNote`;
      // `CorporateInquiriesPage.tsx` — `accessCodeId`), the guest
      // submits through the server (`/api/corporate/inquiry`, Admin
      // SDK), and the staging reset deletes via the Admin SDK too.
      // So the grant was never used and was pure destructive
      // surface for a front-desk account: one delete destroys the
      // pipeline record for a live corporate negotiation. Deleting
      // an inquiry is admin-only now; the desk keeps the whole
      // documented pipeline workflow (move through stages, log
      // notes, issue the access code).
      allow delete: if isAdmin();
    }

    match /corporateInvoices/{invoiceId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(["companyName", "bookingIds", "bookingRefs", "amount", "status", "issuedAt", "issuedBy", "paidAt", "paidBy"])
        && request.resource.data.companyName is string
        && request.resource.data.bookingIds is list
        && request.resource.data.bookingRefs is list
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.status == "issued"
        && request.resource.data.issuedAt == request.time
        && request.resource.data.issuedBy == request.auth.uid
        && request.resource.data.paidAt == null
        && request.resource.data.paidBy == null;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "paidAt", "paidBy"])
        && resource.data.status == "issued"
        && request.resource.data.status == "paid"
        && request.resource.data.paidAt == request.time
        && request.resource.data.paidBy == request.auth.uid;
      allow delete: if false;
    }

    match /contactInquiries/{inquiryId} {
      allow read, update, delete: if isStaff();
      allow create: if isStaff();
    }

    match /dailyCloses/{dateStr} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(["dateStr", "closedAt", "closedBy", "recordedNet", "countedNet", "variance", "notes"])
        && request.resource.data.dateStr == dateStr
        && request.resource.data.closedAt == request.time
        && request.resource.data.closedBy is string
        && request.resource.data.recordedNet is map
        && request.resource.data.countedNet is map
        && request.resource.data.variance is map
        && request.resource.data.notes is string;
      allow update, delete: if false;
    }

    // Per BI-08 (booking-intercom audit 2026-07-06): the
    // previous `allow read: if true` on both collections let
    // any anonymous visitor dump every voucher code, discount
    // value, usage cap, corporate access code, company name,
    // and negotiated `ratePerRoomType` via a single collection
    // query. The point of `/api/validate/*` (per
    // `plan/docs/GOTCHAS.md` "never expose full voucher or
    // code documents to the client") is to expose only the
    // minimum data needed for validation — the API endpoint
    // returns discount type/value (vouchers) or rate map
    // (corporate codes), never the raw document. Tightening
    // the rule to staff-only is safe because the guest-app
    // code never reads these collections client-side (the
    // API is the only sanctioned path). Admin staff reads
    // them via authenticated sessions.
    // Per F01-CORP (2026-10-22, P5 production QA): the
    // `corporateCodes` write rule was `allow write: if isStaff()`.
    // A FRONT-DESK account could therefore reprice or deactivate a
    // negotiated corporate rate straight from the Firestore SDK.
    // The admin UI gate on the Rates page
    // (`AdminLayout.tsx` — `restrictedPaths = ["/rates", "/members",
    // "/settings"]`) is COSMETIC for this collection, because every
    // write here happens CLIENT-side (`AdminContext.tsx` —
    // `updateCorporateCode`, `toggleCorporateCodeActive`,
    // `deleteCorporateCode`) and the desk role is allowed to reach
    // Firestore directly. `ratePerRoomType` IS the negotiated
    // nightly rate the guest is charged on `/corporate/book`, so this
    // is direct revenue loss.
    //
    // CREATE stays staff-wide ON PURPOSE — the desk's documented
    // job is to negotiate a rate and issue the code. Per
    // `plan/features/CORPORATE-INQUIRIES.md` §Generate Access Code
    // (reachable from the front-desk Corporate Inquiries page per
    // `plan/features/AUTH-ROLES.md` §Roles), the desk writes
    // `corporateCodes/{code}` with `companyName`, `ratePerRoomType`,
    // `expiresAt`, `usageCap`, `usageCount: 0`, `linkedInquiryId`,
    // `createdBy`, `isActive: true`, then links it back with
    // `corporateInquiries/{id}.accessCodeId`. Minting the code at
    // the desk IS the workflow; repricing a code that ALREADY
    // EXISTS is not.
    //
    // So the split is by OPERATION, not by role:
    //   create → staff        (the desk's Generate Access Code flow)
    //   update → admin only   (reprice / deactivate an existing code)
    //   delete → admin only
    // The admin-only Rates page is the only client writer of
    // update/delete, so admin keeps the full surface. The server
    // (Admin SDK — `bookings.ts`, `corporate-codes.ts`) bypasses
    // these rules entirely, so the server-side `usageCount` counter
    // and the corporate-booking redemption path are unaffected.
    match /corporateCodes/{code} {
      allow read: if isStaff();
      allow create: if isStaff();
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // Per PR-AUDIT-B2 (2026-10-20): the Spark Rewards portal reads
    // the member's OWN free-night vouchers client-side
    // (`RewardsPage.tsx` — `where("kind","==","reward")` +
    // `where("memberId","==",uid)`). The pre-existing rule was
    // `isStaff()` only, so a signed-in member's read was
    // PERMISSION_DENIED and the portal silently rendered an empty
    // voucher list (the error handler set `rewardVouchers` to `[]`,
    // and the code comment claimed an owner-scoped rule that never
    // existed). The fix adds an owner-scoped branch: Firestore can
    // prove `resource.data.memberId == request.auth.uid` from the
    // query's `where("memberId","==",uid)` constraint, so the
    // portal's query is allowed while every other member's vouchers
    // stay unreadable. Promo vouchers carry no `memberId` and are
    // excluded by both the `kind == "reward"` filter and this rule.
    match /vouchers/{voucherId} {
      allow read: if isStaff()
        || (signedIn() && resource.data.memberId == request.auth.uid);
      // Per F01-VOU (2026-10-22, P5 production QA): the voucher
      // WRITE was `allow write: if isStaff()`, so a front-desk
      // account could mint or reprice a promo voucher (an arbitrary
      // discount) straight from the Firestore SDK. The Rates page is
      // admin-only in the UI, but that gate is cosmetic here: the
      // writes are CLIENT-side (`AdminContext.tsx` — `addVoucher`,
      // `updateVoucher`, `toggleVoucherActive`).
      //
      // Admin-only is safe because the Rates page is the ONLY client
      // writer of this collection:
      //   - `addVoucher` / `updateVoucher` / `toggleVoucherActive`
      //     are consumed ONLY by `admin-app/src/pages/RatesPage.tsx`
      //     (admin-only page — `AdminLayout.tsx` `restrictedPaths`).
      //   - The Spark Rewards portal (`guest-app/src/pages/
      //     RewardsPage.tsx`) only READS its own reward vouchers —
      //     it has no `setDoc` / `updateDoc` / `deleteDoc` at all.
      //   - The free-night REWARD voucher is minted SERVER-side at
      //     checkout (`guest-app/server/handlers/bookings.ts` —
      //     `adminDb.collection("vouchers").doc(freeNightCode)`),
      //     and the Admin SDK bypasses these rules.
      //   - The `usageCount` counter is incremented / decremented
      //     SERVER-side (`bookings.ts` — `transaction.update(
      //     voucherRef, { usageCount })`, Admin SDK).
      // No member-issued or desk-issued voucher is written from a
      // client, so `isAdmin()` closes the hole without breaking a
      // documented workflow.
      allow write: if isAdmin();
    }

    // Per PR-AUDIT-B5 (2026-10-20): the intercom thread document was
    // `allow read, create, update: if true`. `resolved` is the flag the
    // desk's inbox uses to decide whether a request is still open, so
    // ANY anonymous caller could set `resolved: true` and silence a
    // real guest's live request to the front desk. The guest app never
    // reads or writes this document client-side (it uses the
    // server endpoints), so staff-only is safe here.
    match /intercoms/{roomId} {
      allow read: if isStaff();
      allow write: if isStaff();

      // Per PR-AUDIT-B3 (2026-10-20): the message documents used to be
      // `allow read: if true`, so any anonymous caller could read every
      // room's guest↔desk conversation (guest name, message text,
      // `currentStayId`, `orderRef`). The guest's own thread now lives
      // under `intercomSessions/{sessionToken}` — see that block. This
      // legacy path keeps the desk's history visible to staff only.
      match /messages/{messageId} {
        allow read: if isStaff();
        allow create: if isStaff()
          && request.resource.data.keys().hasOnly([
            "text",
            "sender",
            "guestName",
            "timestamp",
            "isRead",
            "isQuickRequest",
            "isStoreOrder",
            "orderRef",
            "isEarlyCheckInRequest",
            "currentStayId",
            // Per `feat/call-history-messages` + decision #214
            // (2026-08-19): four optional fields on system messages
            // that surface the call outcome in the chat thread.
            // `messageType` drives the distinct render;
            // `callStartedAt` + `callDuration` carry the
            // answered-call telemetry; `callAnsweredByName` is the
            // staff attribution written by the `runTransaction`
            // claim in `AdminContext.acceptCall` and surfaces in
            // the chat thread as "Call answered by {Name} at
            // {clock} · {duration}". All four are optional so
            // existing chat messages are unaffected. See
            // `firebase/tests/intercoms-messages-call-history-
            // rules.emulator.test.ts` for the contract pin + the
            // negative case (a non-allowlisted key is rejected).
            "messageType",
            "callStartedAt",
            "callDuration",
            "callAnsweredByName"
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && request.resource.data.sender in ["guest", "front-desk", "system"]
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() <= 120
          && request.resource.data.timestamp == request.time
          && (!("currentStayId" in request.resource.data.keys()) || request.resource.data.currentStayId == null || request.resource.data.currentStayId is string)
          // When sender === "system", the messageType must be one
          // of the four documented call outcomes (or absent for
          // future-proofing). No ad-hoc "system" docs without a
          // type — keeps the audit trail structured.
          // Per decision #217 (2026-08-19): "call-failed" joins the
          // enum. The pre-#217 enum was 3 values; the post-#217
          // enum is 4. The enum is closed (no fallback to
          // anything-else) so a typo on the client side is
          // rejected by the rule instead of silently writing
          // a malformed audit-trail doc. See
          // `shared/types/index.ts §IntercomMessageType` for the
          // matching TypeScript union — the two must stay in
          // sync.
          && (request.resource.data.sender != "system"
              || (request.resource.data.keys().hasAny(["messageType"])
                  && request.resource.data.messageType in ["call-answered", "call-missed", "call-declined", "call-failed"]));
        allow update: if isStaff()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead"]);
        allow delete: if isStaff();
      }
    }

    // Per PR-AUDIT-B4 (2026-10-20): the WebRTC signalling path was
    // `allow read, write: if true` — ANY anonymous caller could read
    // every room's call document (which carries `guestName`) and, far
    // worse, WRITE one: setting `status: "active"` with an attacker
    // supplied SDP would point the guest's peer connection at the
    // attacker. The legacy path is now staff-only.
    match /calls/{roomId}/{document=**} {
      allow read, write: if isStaff();
    }

    // ── Capability-scoped guest sessions ─────────────────────────────
    //
    // Per PR-AUDIT-B3 / B4 (2026-10-20).
    //
    // The guest intercom is used by WALK-IN guests who are not signed
    // in, so Firestore rules cannot authorize them per-user: a rule
    // can only compare against `request.auth`, and an anonymous guest
    // has no `request.auth`. There is therefore no way to keep a
    // guest's realtime read on a room-scoped collection while making
    // it non-public.
    //
    // The fix is a CAPABILITY model. When a guest verifies their stay,
    // the server issues a random 32-hex `sessionToken` and returns it
    // to that guest. The token is stored on the (now staff-only)
    // `intercoms/{roomId}` document and is NOT enumerable from the
    // client. The guest's documents live under a path that CONTAINS
    // the token:
    //
    //     intercomSessions/{sessionToken}/messages/{messageId}
    //     callSessions/{sessionToken}
    //     callSessions/{sessionToken}/iceCandidates/{candidateId}
    //
    // A caller who cannot construct the path cannot read the
    // documents. This is the same "unguessable share link" model the
    // booking-lookup token already uses. Because the rules below are
    // unconditional, Firestore can evaluate them for both single-doc
    // reads and list queries (an unconditional rule needs no
    // "query is provably safe" analysis).
    //
    // The token is 32 hex characters from `crypto.randomBytes(16)` —
    // 128 bits of entropy. It is regenerated whenever the stay
    // changes, so a previous guest's token cannot read the next
    // guest's thread.
    match /intercomSessions/{sessionToken} {
      allow read: if isStaff();
      allow write: if isStaff();

      match /messages/{messageId} {
        // Capability read — see the block comment above.
        allow read: if true;
        // Guest messages are written by the SERVER endpoint only (it
        // verifies the stay and stamps the guest's identity). The
        // server uses the Admin SDK, which bypasses rules entirely, so
        // this branch never needs to admit a guest client.
        //
        // STAFF create is REQUIRED, and was a live production bug:
        // the desk's reply is a client-side `addDoc` into this same
        // collection (AdminContext — `collection(db, "intercomSessions",
        // sessionToken, "messages")`). `create` and `update` are
        // DISTINCT operations, so `allow update: if isStaff()` does not
        // cover a new reply document. A blanket `allow create: if
        // false` therefore denied EVERY desk reply with
        // PERMISSION_DENIED — the guest's message arrived (the server
        // writes it), the desk saw it in the inbox, and the reply was
        // rejected. Proven in the emulator on 2026-10-21, against the
        // rule that shipped live in 2.18.5.
        allow create: if isStaff();
        // The guest marks the desk's messages as read in their own
        // thread; no other field may be touched.
        allow update: if isStaff()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead"]);
        allow delete: if isStaff();
      }
    }

    match /callSessions/{sessionToken} {
      // Capability read/write — see the block comment above. The
      // guest writes the WebRTC offer and ICE candidates; the desk
      // writes the answer. Both sides hold the same token.
      //
      // DELETE is included DELIBERATELY: the guest cleans up its own
      // call session on hang-up (`deleteDoc(doc(db, "callSessions",
      // sessionToken))` in IntercomPage.tsx). A separate
      // `allow delete: if isStaff()` here was DEAD CODE — in Firestore
      // rules `write` is shorthand for create + update + delete, and
      // matching allow statements are OR'd, so the unconditional
      // `write` granted delete regardless of what the delete line
      // said. The token holder owns this document; spelling the
      // operations out states that intent instead of contradicting it.
      allow read, create, update, delete: if true;

      match /iceCandidates/{candidateId} {
        // Same ownership model as the parent session document — the
        // token holder adds and removes its own ICE candidates.
        allow read, create, update, delete: if true;
      }
    }

    // Per QA-REPORT-2026-10-23 §3.10 (the desk's incoming-call
    // listener is denied in production — "Missing or insufficient
    // permissions" on EVERY admin sign-in, for BOTH staff roles): the
    // admin app listens for incoming room calls with a COLLECTION-GROUP
    // query over "callSessions" (`AdminContext.tsx` —
    // `collectionGroup(db, "callSessions")`).
    //
    // A group query is only provable if the rules guarantee that EVERY
    // document in the group is readable, at EVERY depth. The capability
    // block above covers ONLY the top-level `callSessions/{sessionToken}`
    // (a `match` block does NOT cascade into subcollections), so with no
    // rule for a nested `<any-depth>/callSessions/{sessionToken}` path the group
    // query could not be proven safe and Firestore DENIED it outright —
    // even for a signed-in admin, and even though `collection("callSessions")`
    // (top level only) returned 200.
    //
    // This block is the same shape as the `messages` group rule below and
    // as the `charges` / `payments` / `refunds` group rules at the bottom
    // of this file: a recursive wildcard that grants STAFF the read at any
    // depth. It grants the desk nothing new — the concrete call-session
    // documents the desk touches are the top-level ones, already
    // staff-readable — and it does NOT widen the guest's access: the
    // guest still reaches its own session through the capability block
    // above, and a NON-STAFF group query stays DENIED, because a group
    // query is only allowed for a caller when EVERY arm in the group is
    // provably satisfied for them (this arm is conditional on
    // `isStaff()`).
    match /{path=**}/callSessions/{sessionToken} {
      allow read: if isStaff();
    }

    // Per PR-AUDIT-B3 (2026-10-20): the desk's inbox reads BOTH the
    // legacy `intercoms/{room}/messages` thread and the guest's
    // `intercomSessions/{token}/messages` thread with a single
    // collection-group query over "messages". This block makes that
    // query explicit for staff. It grants the desk NOTHING new — both
    // concrete message paths were already staff-readable — and it does
    // not widen the guest's access, which still comes from the
    // capability block above.
    match /{path=**}/messages/{messageId} {
      allow read: if isStaff();
    }

    match /storeItems/{itemId} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Per QA §3.7 (2026-10-26): the desk's store-order STATUS is owned by
    // the SERVER, not by a client write.
    //
    // The desk's order actions used to be a raw client-side `updateDoc`, so
    // the state machine existed only as UI BUTTONS — nothing enforced it.
    // Any staff client could write ANY status onto ANY order, including
    // cancelling an order that had already been DELIVERED and whose direct
    // payment had been collected: money collected against a void order, a
    // guest who is never told, and a reconciliation delta that never closes.
    //
    // The fix moved every transition onto the server (`POST /api/store/…`),
    // which refuses any transition on an order that holds a tender. But the
    // RULE was the last line and it stayed open — so the fix was only
    // enforced as long as the app kept its hands off the document.
    //
    // This closes it: a client may no longer change `status` at all. The
    // server writes it through the Admin SDK, which bypasses these rules.
    //
    // The other fields stay staff-writable, because the desk's "bill to room"
    // action is a legitimate client write: it sets `isBilled` / `billedAt` /
    // `updatedAt` / `handledBy` and never touches `status`.
    match /storeOrders/{orderId} {
      allow read: if isStaff();
      allow create: if false;
      allow update: if isStaff()
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(["status"]);
      allow delete: if isAdmin();
    }

    // Per Phase 12 — Notification Center (decision #120):
    // persisted operational alerts for staff. One doc per
    // event, written server-side via the Admin SDK from the
    // existing API routes (booking create / add-payment /
    // confirm / check-in / check-out / store order placed).
    // Guests must never read or write this collection.
    // Staff can mark their own UID in the `readBy` field
    // (per-staff read trail); create is Admin-SDK-only. The
    // retention cron hard-deletes docs older than 30 days —
    // runs as Admin SDK, so no client delete is allowed.
    //
    // Per NC-02 / NC-02b / NC-02c (post-ship review
    // 2026-07-15): the original rule let any staff member
    // rewrite the whole `readBy` map (clear/forge another
    // staff member's read state). The update rule below
    // enforces two halves so the key set can only *grow by
    // the writer's own UID*: (a) any added key (new keys
    // minus existing keys) may only be the writer's UID;
    // (b) every existing key must survive (no removal).
    // NC-02c: (a) is expressed with `removeAll` (a List op)
    // rather than `.union()` — `keys()` returns a List and
    // `.union()` is Set-only, which the Firebase rules
    // validator flagged as a type warning that errored the
    // rule at evaluation time (would have denied all
    // mark-read writes). Value-tampering on others' existing
    // entries stays reachable (rules can't loop over map
    // values to compare each unchanged) and is knowingly
    // accepted at SEV-4 — trusted staff, worst case a wrong
    // unread badge on a colleague's session.
    match /notifications/{notificationId} {
      allow read: if isStaff();
      allow create: if false;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"])
        // NC-02: any key being *added* (new keys minus existing keys)
        // may only be the writer's own UID. `keys()` returns a List, so
        // this uses `removeAll` (List op) — NOT `.union()`, which is a
        // Set-only method and produced a validator type warning that
        // errored the rule at evaluation time (NC-02c, 2026-07-15).
        && request.resource.data.readBy.keys().removeAll(resource.data.readBy.keys()).hasOnly([request.auth.uid])
        // NC-02b: every existing key must survive (no removal of another
        // staff member's entry). Combined with the line above, the key
        // set can only grow by the writer's own UID.
        && resource.data.readBy.keys().hasOnly(
          request.resource.data.readBy.keys()
        )
        && request.resource.data.readBy[request.auth.uid] is timestamp;
      allow delete: if false;
    }
    // Per #11 (operator-reported 2026-08-20, tracked in
    // `plan/project/ROADMAP.md §Open Operator-Reported Bugs →
    // #11`): the `failed_emails` collection is the DLQ for
    // every Resend send failure. The `sendEmail` wrapper at
    // `guest-app/server/handlers/email.ts` writes a row on
    // every Resend error. The admin dashboard renders a
    // `FailedEmailsBanner` from this collection so the
    // desk can see + retry the failures.
    //
    // Auth posture: admin-only read (mirrors the canonical
    // admin write posture; front-desk staff should not
    // see failed emails since they cannot resolve them
    // without Resend credentials). Server-side write
    // (the `sendEmail` wrapper is server-side — the client
    // never writes to this collection directly).
    match /failed_emails/{failureId} {
      allow read: if isAdmin();
      // Server-only writes — the `sendEmail` wrapper is
      // server-side (admin SDK), the client never
      // writes to this collection. Explicitly false on
      // the client to defend against any future caller
      // that bypasses the server.
      allow create, update, delete: if false;
    }
    // ── collectionGroup rules ──────────────────────────────────────────────
    // Firestore requires explicit collectionGroup rules for cross-document
    // queries (collectionGroup(db, "charges") / "payments"). The nested
    // document rules above cover single-document reads but not group queries.

    match /{path=**}/charges/{chargeId} {
      allow read: if isStaff();
      allow update, delete: if false;
    }

    match /{path=**}/payments/{paymentId} {
      allow read: if isStaff();
      allow update, delete: if false;
    }

    // Per RPT-03 (2026-08-07): the `refunds` collectionGroup
    // (read by `LiabilityTab` to project each liability's
    // live `processedAmount`). The nested per-doc rule on
    // `reservations/{id}/refunds/{id}` only covers direct path
    // reads — Firestore requires an explicit collectionGroup
    // rule for cross-document `collectionGroup(db, "refunds")`
    // queries. Without this, staff got "Missing or insufficient
    // permissions" the moment the Liability tab mounted.
    match /{path=**}/refunds/{refundId} {
      allow read: if isStaff();
      allow update, delete: if false;
    }

    // Per OCT-H6 (2026-10-20, audit
    // `plan/project/AUDIT-OCTOBER-2026.md`): the BR-01 breakfast
    // + BR-12 other-add-on audit trails, read via
    // `collectionGroup(db, "breakfastAudit")` +
    // `collectionGroup(db, "otherAddOnAudit")` in the admin
    // Reports page (the "Late changes" metric).
    //
    // Same failure mode as the `refunds` group rule above:
    // the nested per-doc rule only covers direct path reads, and
    // Firestore requires an EXPLICIT collectionGroup rule for
    // cross-document group queries. These collections shipped in
    // October without one, so both listeners failed with
    // PERMISSION_DENIED and the late-change counters were
    // permanently 0.
    match /{path=**}/breakfastAudit/{auditId} {
      allow read: if isStaff();
      allow update, delete: if false;
    }

    match /{path=**}/otherAddOnAudit/{auditId} {
      allow read: if isStaff();
      allow update, delete: if false;
    }

    // Per ETR-R07 (staging isolation metadata) +
    // ETR-D02 (Restricted Diagnostic Mode locks
    // everyday staging): the refresh-snapshot
    // docs in `janitor/refresh-snapshots/{snapshotId}`
    // are read by Admin only (front-desk staff
    // should never see production data leaked
    // into staging). The `outbound-suppression`
    // collection is also Admin-only. Both
    // collections are written by the server
    // (no client writes).
    match /janitor/refresh-snapshots/{snapshotId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /janitor/refresh-snapshots/{snapshotId}/items/{itemId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    // Per ETR-D05 (force-disable outbound
    // side effects): the outbound-suppression
    // docs are written by the server (admin
    // SDK) + read by the client SDK (so
    // email.ts / notifications.ts can check
    // the flag before firing). The client
    // can read ONLY docs that are still
    // active (the expiresAt is in the future)
    // + only if the requester is an Admin
    // (the isStaff() check covers all staff
    // roles; the read here is narrowed to
    // admin-only because the outbound
    // suppression gate is part of the
    // Restricted Diagnostic Mode admin
    // flow — front-desk staff never trigger
    // an outbound call that this flag would
    // gate).
    match /janitor/outbound-suppression/{snapshotId} {
      allow read: if isAdmin() && resource.data.expiresAt.toMillis() > request.time.toMillis();
      allow create, update, delete: if false;
    }
    match /janitor/refresh-access-audit/{auditId} {
      // The access audit is written by the
      // server + read by Admin (for the
      // audit-log view in Settings).
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
