rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn() && request.auth.token.role in ["front-desk", "admin"];
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == "admin";
    }

    match /rooms/{roomId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /bookings/{bookingId} {
      allow read: if isStaff();
      allow create: if false;
      allow update: if isStaff();
      allow delete: if isAdmin();

      match /payments/{paymentId} {
        allow read, create: if isStaff();
        allow update, delete: if false;
      }
    }

    match /guests/{userId} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == userId);
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /members/{userId} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == userId);
      allow create: if false;
      allow update: if signedIn() && (isStaff() || request.auth.uid == userId);
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);

      match /pointsHistory/{entryId} {
        allow read: if isStaff() || (signedIn() && request.auth.uid == userId);
        allow create: if isStaff();
        allow update, delete: if false;
      }
    }

    match /settings/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /corporateInquiries/{inquiryId} {
      allow read, update, delete: if isStaff();
      allow create: if isStaff();
    }

    match /corporateCodes/{code} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /vouchers/{voucherId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /intercoms/{roomId}/{document=**} {
      allow read, write: if true;
    }

    match /calls/{roomId}/{document=**} {
      allow read, write: if true;
    }

    match /storeItems/{itemId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /storeOrders/{orderId} {
      allow read, create: if true;
      allow update: if isStaff();
      allow delete: if isAdmin();
    }

    match /breakfastSelections/{selectionId} {
      allow read, write: if isStaff();
    }
  }
}
