rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn() && 'role' in request.auth.token && request.auth.token.role in ["front-desk", "admin"];
    }

    function isAdmin() {
      return signedIn() && 'role' in request.auth.token && request.auth.token.role == "admin";
    }

    match /rooms/{roomId} {
      allow read: if true;
      // Per W3.4 / `plan/features/ROOM-MANAGEMENT.md §Delete`: only
      // admins can hard-delete a room document. Front-desk can still
      // create, edit, and toggle active/blocked status.
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /roomPrivate/{roomId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /roomBlocks/{blockId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /roomDeletionAudit/{auditId} {
      allow read: if isStaff();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /bookings/{bookingId} {
      allow read: if isStaff();
      allow create: if false;
      // Per MRB-01 (2026-08-02, per decision #159): the four
      // `reservation*` fields on a booking are server-assigned
      // projections of the parent `reservations/{id}` document.
      // The `affectedKeys().hasOnly([...])` allowlist below does
      // NOT list them, so any client write that touches
      // `reservationId` / `reservationRef` / `reservationPosition`
      // / `reservationRoomCount` is implicitly denied by omission.
      // (The pin test in
      // `firebase/tests/reservation-rules.emulator.test.ts` asserts
      // the implicit-deny contract — a future refactor that
      // accidentally widens the allowlist breaks the test.)
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "guestIdPhotoUrl",
          "guestRegistration",
          "breakfastSelections",
          "breakfastServed",
          "discountVerified",
          "discountVerifiedBy",
          "discountRejected",
          "notes",
          "specialRequests",
          "handledBy",
          "updatedAt"
        ]);
      allow delete: if isAdmin();

      match /payments/{paymentId} {
        allow read: if isStaff();
        allow create: if false; // Server-authoritative payment/refund APIs only.
        allow update, delete: if false;
      }

      match /charges/{chargeId} {
        allow read: if isStaff();
        allow create: if isStaff()
          && request.resource.data.keys().hasOnly(["label", "amount", "category", "note", "addedBy", "addedAt", "voidOf"])
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 120
          && request.resource.data.amount is number
          && request.resource.data.amount != 0
          && request.resource.data.amount <= 1000000
          && request.resource.data.amount >= -1000000
          && request.resource.data.category in ["late-checkout", "early-checkin", "extra-person", "damage", "laundry", "other"]
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 300
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.addedAt == request.time
          && (
            (request.resource.data.amount > 0 && request.resource.data.voidOf == null)
            || (
              request.resource.data.amount < 0
              && request.resource.data.voidOf is string
              && chargeId == "void-" + request.resource.data.voidOf
              && get(/databases/$(database)/documents/bookings/$(bookingId)/charges/$(request.resource.data.voidOf)).data.amount == -request.resource.data.amount
            )
          );
        allow update, delete: if false;
      }
    }

    // Per W1.4 / decision #49 / audit S2.3: anonymized booking audit
    // records written by /api/members/delete-account. Staff can read
    // for accounting / RA 11862 compliance; clients cannot write or
    // read; server-side only.
    match /bookings/audit/records/{auditId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /financeIntegrityRepairs/{repairId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Per MRB-01 (2026-08-02, per decision #159): the reservation
    // header. Server-authoritative create / update / delete — the
    // public ref, lead booker, source / corporate context, payment
    // state, voucher / member discount, consent, and group totals
    // are all written through Admin SDK transactions. Staff can
    // read for the admin booking drawer; guests never have direct
    // access (the public lookup resolves the reservation via the
    // pre-allocated `reservationId` + the verified email / token
    // credential, gated by /api/bookings/lookup).
    //
    // Subcollections mirror the booking's money-shape so MRB-04's
    // folio migration (payments + charges + refunds on the
    // reservation) and MRB-07's refund-state machine can land
    // without a second rules change. The `payments` and `refunds`
    // subcollections are server-only (no client create — same shape
    // as the existing booking payments rule); the `charges`
    // subcollection allows staff direct write (same shape as the
    // existing booking charges rule, with the per-creator + bounds
    // + void semantics).
    match /reservations/{reservationId} {
      allow read: if isStaff();
      allow write: if false;  // Server-authoritative; Admin SDK only.

      match /payments/{paymentId} {
        allow read: if isStaff();
        allow create: if false;  // Server-authoritative payment/refund APIs only.
        allow update, delete: if false;
      }

      // Per MRB-04 Phase 2.x (2026-08-02, per decision #159): the
      // canonical refund source for new reservations. The
      // `handleAddRefund` writer only writes to `refunds/`; the
      // helper `getReservationFolioSummary` reads BOTH `payments/`
      // (for any negative-amount entries — belt-and-suspenders) AND
      // `refunds/` (canonical). Server-only: refunds are admin-only
      // and require a `client-preallocated refundId` for CRL-01
      // idempotency. Same shape as the `payments/` subcollection —
      // no client create/update/delete; staff read.
      match /refunds/{refundId} {
        allow read: if isStaff();
        allow create: if false;  // Server-authoritative refund APIs only.
        allow update, delete: if false;
      }

      match /charges/{chargeId} {
        allow read: if isStaff();
        allow create: if isStaff()
          && request.resource.data.keys().hasOnly(["label", "amount", "category", "note", "addedBy", "addedAt", "voidOf", "bookingId"])
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 120
          && request.resource.data.amount is number
          && request.resource.data.amount != 0
          && request.resource.data.amount <= 1000000
          && request.resource.data.amount >= -1000000
          && request.resource.data.category in ["late-checkout", "early-checkin", "extra-person", "damage", "laundry", "other"]
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 300
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.addedAt == request.time
          && request.resource.data.bookingId is string
          && request.resource.data.bookingId.size() > 0
          && request.resource.data.bookingId.size() <= 128
          && get(/databases/$(database)/documents/bookings/$(request.resource.data.bookingId)).data.reservationId == reservationId
          && (
            (request.resource.data.amount > 0 && request.resource.data.voidOf == null)
            || (
              request.resource.data.amount < 0
              && request.resource.data.voidOf is string
              && chargeId == "void-" + request.resource.data.voidOf
              && get(/databases/$(database)/documents/reservations/$(reservationId)/charges/$(request.resource.data.voidOf)).data.amount == -request.resource.data.amount
              && get(/databases/$(database)/documents/reservations/$(reservationId)/charges/$(request.resource.data.voidOf)).data.bookingId == request.resource.data.bookingId
            )
          );
        allow update, delete: if false;
      }
    }

    // FD-02 (E2E audit 2026-07-17): signed-in users may update only
    // legitimate self-service profile fields. The `role`, `isActive`,
    // and staff-audit fields are reserved for admin/server writes.
    // Admin SDK staff provisioning and valid Spark Rewards profile
    // editing (fullName, phone, photoUrl) are preserved.
    match /guests/{userId} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == userId);
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            "fullName",
            "displayName",
            "phone",
            "photoUrl",
            "address",
            "dateOfBirth",
            "emergencyContact",
            "preferences",
            "audioRouting",
            "audioRoutingUpdatedAt",
            "updatedAt"
          ])
        );
      allow delete: if isAdmin();
    }

    match /members/{userId} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == userId);
      allow create: if false;
      // Per Spark Rewards audit 2026-07-18 MED-1: the staff-side
      // update is restricted to a field allowlist that does NOT
      // include `rewardsPoints` (or other financial fields). All
      // balance mutations are server-side via the Admin SDK now:
      //   - /api/members/redeem-points (staff)
      //   - /api/members/undo-redemption (admin)
      //   - /api/members/manual-adjust (admin, MED-1 fix)
      //   - checkout-time earn via the existing API routes
      // The `rewardsPoints` field is no longer writable from any
      // client. The member self-update branch (fullName, phone,
      // photoUrl) is unchanged.
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly([
            "isActive",
            "isMember",
            "tier",
            "memberSince",
            "memberNumber",
            "notes",
            "handledBy",
            "updatedAt"
          ])
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["fullName", "phone", "photoUrl", "updatedAt"])
        );
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);

      match /pointsHistory/{entryId} {
        // Per MED-1: history writes happen inside the server
        // transaction (Admin SDK bypasses rules), so the staff
        // `allow create` is no longer needed. We still permit
        // `isStaff()` here as a defense-in-depth fallback — if a
        // future migration ever needs to backfill from the
        // client, the path exists — but the only live writer in
        // the codebase is the server. The integrity invariant
        // (balance == sum(history)) is enforced at the
        // server-transaction boundary, not here.
        allow read: if isStaff() || (signedIn() && request.auth.uid == userId);
        allow create: if isStaff();
        allow update, delete: if false;
      }
    }

    match /settings/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /corporateInquiries/{inquiryId} {
      allow read, update, delete: if isStaff();
      allow create: if isStaff();
    }

    match /corporateInvoices/{invoiceId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(["companyName", "bookingIds", "bookingRefs", "amount", "status", "issuedAt", "issuedBy", "paidAt", "paidBy"])
        && request.resource.data.companyName is string
        && request.resource.data.bookingIds is list
        && request.resource.data.bookingRefs is list
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.status == "issued"
        && request.resource.data.issuedAt == request.time
        && request.resource.data.issuedBy == request.auth.uid
        && request.resource.data.paidAt == null
        && request.resource.data.paidBy == null;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "paidAt", "paidBy"])
        && resource.data.status == "issued"
        && request.resource.data.status == "paid"
        && request.resource.data.paidAt == request.time
        && request.resource.data.paidBy == request.auth.uid;
      allow delete: if false;
    }

    match /contactInquiries/{inquiryId} {
      allow read, update, delete: if isStaff();
      allow create: if isStaff();
    }

    match /dailyCloses/{dateStr} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(["dateStr", "closedAt", "closedBy", "recordedNet", "countedNet", "variance", "notes"])
        && request.resource.data.dateStr == dateStr
        && request.resource.data.closedAt == request.time
        && request.resource.data.closedBy is string
        && request.resource.data.recordedNet is map
        && request.resource.data.countedNet is map
        && request.resource.data.variance is map
        && request.resource.data.notes is string;
      allow update, delete: if false;
    }

    // Per BI-08 (booking-intercom audit 2026-07-06): the
    // previous `allow read: if true` on both collections let
    // any anonymous visitor dump every voucher code, discount
    // value, usage cap, corporate access code, company name,
    // and negotiated `ratePerRoomType` via a single collection
    // query. The point of `/api/validate/*` (per
    // `plan/docs/GOTCHAS.md` "never expose full voucher or
    // code documents to the client") is to expose only the
    // minimum data needed for validation — the API endpoint
    // returns discount type/value (vouchers) or rate map
    // (corporate codes), never the raw document. Tightening
    // the rule to staff-only is safe because the guest-app
    // code never reads these collections client-side (the
    // API is the only sanctioned path). Admin staff reads
    // them via authenticated sessions.
    match /corporateCodes/{code} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /vouchers/{voucherId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /intercoms/{roomId} {
      allow read, create, update: if true;
      allow delete: if isStaff();

      // G-04 (E2E audit 2026-07-17): guest messages are routed through
      // the rate-limited API endpoint. Only staff can create messages
      // directly (replies). Guest reads and staff full CRUD are preserved.
      match /messages/{messageId} {
        allow read: if true;
        allow create: if isStaff()
          && request.resource.data.keys().hasOnly([
            "text",
            "sender",
            "guestName",
            "timestamp",
            "isRead",
            "isQuickRequest",
            "isStoreOrder",
            "orderRef",
            "isEarlyCheckInRequest",
            "currentStayId",
            // Per `feat/call-history-messages` + decision #214
            // (2026-08-19): four optional fields on system messages
            // that surface the call outcome in the chat thread.
            // `messageType` drives the distinct render;
            // `callStartedAt` + `callDuration` carry the
            // answered-call telemetry; `callAnsweredByName` is the
            // staff attribution written by the `runTransaction`
            // claim in `AdminContext.acceptCall` and surfaces in
            // the chat thread as "Call answered by {Name} at
            // {clock} · {duration}". All four are optional so
            // existing chat messages are unaffected. See
            // `firebase/tests/intercoms-messages-call-history-
            // rules.emulator.test.ts` for the contract pin + the
            // negative case (a non-allowlisted key is rejected).
            "messageType",
            "callStartedAt",
            "callDuration",
            "callAnsweredByName"
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && request.resource.data.sender in ["guest", "front-desk", "system"]
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() <= 120
          && request.resource.data.timestamp == request.time
          && (!("currentStayId" in request.resource.data.keys()) || request.resource.data.currentStayId == null || request.resource.data.currentStayId is string)
          // When sender === "system", the messageType must be one
          // of the four documented call outcomes (or absent for
          // future-proofing). No ad-hoc "system" docs without a
          // type — keeps the audit trail structured.
          // Per decision #217 (2026-08-19): "call-failed" joins the
          // enum. The pre-#217 enum was 3 values; the post-#217
          // enum is 4. The enum is closed (no fallback to
          // anything-else) so a typo on the client side is
          // rejected by the rule instead of silently writing
          // a malformed audit-trail doc. See
          // `shared/types/index.ts §IntercomMessageType` for the
          // matching TypeScript union — the two must stay in
          // sync.
          && (request.resource.data.sender != "system"
              || (request.resource.data.keys().hasAny(["messageType"])
                  && request.resource.data.messageType in ["call-answered", "call-missed", "call-declined", "call-failed"]));
        allow update: if isStaff()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead"]);
        allow delete: if isStaff();
      }
    }

    match /calls/{roomId}/{document=**} {
      allow read, write: if true;
    }

    match /storeItems/{itemId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /storeOrders/{orderId} {
      allow read, update: if isStaff();
      allow create: if false;
      allow delete: if isAdmin();
    }

    // Per Phase 12 — Notification Center (decision #120):
    // persisted operational alerts for staff. One doc per
    // event, written server-side via the Admin SDK from the
    // existing API routes (booking create / add-payment /
    // confirm / check-in / check-out / store order placed).
    // Guests must never read or write this collection.
    // Staff can mark their own UID in the `readBy` field
    // (per-staff read trail); create is Admin-SDK-only. The
    // retention cron hard-deletes docs older than 30 days —
    // runs as Admin SDK, so no client delete is allowed.
    //
    // Per NC-02 / NC-02b / NC-02c (post-ship review
    // 2026-07-15): the original rule let any staff member
    // rewrite the whole `readBy` map (clear/forge another
    // staff member's read state). The update rule below
    // enforces two halves so the key set can only *grow by
    // the writer's own UID*: (a) any added key (new keys
    // minus existing keys) may only be the writer's UID;
    // (b) every existing key must survive (no removal).
    // NC-02c: (a) is expressed with `removeAll` (a List op)
    // rather than `.union()` — `keys()` returns a List and
    // `.union()` is Set-only, which the Firebase rules
    // validator flagged as a type warning that errored the
    // rule at evaluation time (would have denied all
    // mark-read writes). Value-tampering on others' existing
    // entries stays reachable (rules can't loop over map
    // values to compare each unchanged) and is knowingly
    // accepted at SEV-4 — trusted staff, worst case a wrong
    // unread badge on a colleague's session.
    match /notifications/{notificationId} {
      allow read: if isStaff();
      allow create: if false;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["readBy"])
        // NC-02: any key being *added* (new keys minus existing keys)
        // may only be the writer's own UID. `keys()` returns a List, so
        // this uses `removeAll` (List op) — NOT `.union()`, which is a
        // Set-only method and produced a validator type warning that
        // errored the rule at evaluation time (NC-02c, 2026-07-15).
        && request.resource.data.readBy.keys().removeAll(resource.data.readBy.keys()).hasOnly([request.auth.uid])
        // NC-02b: every existing key must survive (no removal of another
        // staff member's entry). Combined with the line above, the key
        // set can only grow by the writer's own UID.
        && resource.data.readBy.keys().hasOnly(
          request.resource.data.readBy.keys()
        )
        && request.resource.data.readBy[request.auth.uid] is timestamp;
      allow delete: if false;
    }
    // Per #11 (operator-reported 2026-08-20, tracked in
    // `plan/project/ROADMAP.md §Open Operator-Reported Bugs →
    // #11`): the `failed_emails` collection is the DLQ for
    // every Resend send failure. The `sendEmail` wrapper at
    // `guest-app/server/handlers/email.ts` writes a row on
    // every Resend error. The admin dashboard renders a
    // `FailedEmailsBanner` from this collection so the
    // desk can see + retry the failures.
    //
    // Auth posture: admin-only read (mirrors the canonical
    // admin write posture; front-desk staff should not
    // see failed emails since they cannot resolve them
    // without Resend credentials). Server-side write
    // (the `sendEmail` wrapper is server-side — the client
    // never writes to this collection directly).
    match /failed_emails/{failureId} {
      allow read: if isAdmin();
      // Server-only writes — the `sendEmail` wrapper is
      // server-side (admin SDK), the client never
      // writes to this collection. Explicitly false on
      // the client to defend against any future caller
      // that bypasses the server.
      allow create, update, delete: if false;
    }
    // ── collectionGroup rules ──────────────────────────────────────────────
    // Firestore requires explicit collectionGroup rules for cross-document
    // queries (collectionGroup(db, "charges") / "payments"). The nested
    // document rules above cover single-document reads but not group queries.

    match /{path=**}/charges/{chargeId} {
      allow read: if isStaff();
      allow update, delete: if false;
    }

    match /{path=**}/payments/{paymentId} {
      allow read: if isStaff();
      allow update, delete: if false;
    }

    // Per RPT-03 (2026-08-07): the `refunds` collectionGroup
    // (read by `LiabilityTab` to project each liability's
    // live `processedAmount`). The nested per-doc rule on
    // `reservations/{id}/refunds/{id}` only covers direct path
    // reads — Firestore requires an explicit collectionGroup
    // rule for cross-document `collectionGroup(db, "refunds")`
    // queries. Without this, staff got "Missing or insufficient
    // permissions" the moment the Liability tab mounted.
    match /{path=**}/refunds/{refundId} {
      allow read: if isStaff();
      allow update, delete: if false;
    }

    // Per ETR-R07 (staging isolation metadata) +
    // ETR-D02 (Restricted Diagnostic Mode locks
    // everyday staging): the refresh-snapshot
    // docs in `janitor/refresh-snapshots/{snapshotId}`
    // are read by Admin only (front-desk staff
    // should never see production data leaked
    // into staging). The `outbound-suppression`
    // collection is also Admin-only. Both
    // collections are written by the server
    // (no client writes).
    match /janitor/refresh-snapshots/{snapshotId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    match /janitor/refresh-snapshots/{snapshotId}/items/{itemId} {
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
    // Per ETR-D05 (force-disable outbound
    // side effects): the outbound-suppression
    // docs are written by the server (admin
    // SDK) + read by the client SDK (so
    // email.ts / notifications.ts can check
    // the flag before firing). The client
    // can read ONLY docs that are still
    // active (the expiresAt is in the future)
    // + only if the requester is an Admin
    // (the isStaff() check covers all staff
    // roles; the read here is narrowed to
    // admin-only because the outbound
    // suppression gate is part of the
    // Restricted Diagnostic Mode admin
    // flow — front-desk staff never trigger
    // an outbound call that this flag would
    // gate).
    match /janitor/outbound-suppression/{snapshotId} {
      allow read: if isAdmin() && resource.data.expiresAt.toMillis() > request.time.toMillis();
      allow create, update, delete: if false;
    }
    match /janitor/refresh-access-audit/{auditId} {
      // The access audit is written by the
      // server + read by Admin (for the
      // audit-log view in Settings).
      allow read: if isAdmin();
      allow create, update, delete: if false;
    }
  }
}
