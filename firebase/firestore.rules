rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn() && request.auth.token.role in ["front-desk", "admin"];
    }

    function isAdmin() {
      return signedIn() && request.auth.token.role == "admin";
    }

    match /rooms/{roomId} {
      allow read: if true;
      // Per W3.4 / `plan/features/ROOM-MANAGEMENT.md §Delete`: only
      // admins can hard-delete a room document. Front-desk can still
      // create, edit, and toggle active/blocked status.
      allow create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /roomPrivate/{roomId} {
      allow read, create, update: if isStaff();
      allow delete: if isAdmin();
    }

    match /roomBlocks/{blockId} {
      allow read: if isStaff();
      allow create, update, delete: if false;
    }

    match /roomDeletionAudit/{auditId} {
      allow read: if isStaff();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    match /bookings/{bookingId} {
      allow read: if isStaff();
      allow create: if false;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          "guestIdPhotoUrl",
          "guestRegistration",
          "breakfastSelections",
          "breakfastServed",
          "paymentReferenceNumber",
          "discountVerified",
          "discountVerifiedBy",
          "discountRejected",
          "notes",
          "specialRequests",
          "handledBy",
          "updatedAt"
        ]);
      allow delete: if isAdmin();

      match /payments/{paymentId} {
        allow read: if isStaff();
        allow create: if false; // Server-authoritative payment/refund APIs only.
        allow update, delete: if false;
      }

      match /charges/{chargeId} {
        allow read: if isStaff();
        allow create: if isStaff()
          && request.resource.data.keys().hasOnly(["label", "amount", "category", "note", "addedBy", "addedAt", "voidOf"])
          && request.resource.data.label is string
          && request.resource.data.label.size() > 0
          && request.resource.data.label.size() <= 120
          && request.resource.data.amount is number
          && request.resource.data.amount != 0
          && request.resource.data.amount <= 1000000
          && request.resource.data.amount >= -1000000
          && request.resource.data.category in ["late-checkout", "early-checkin", "extra-person", "damage", "laundry", "other"]
          && request.resource.data.note is string
          && request.resource.data.note.size() <= 300
          && request.resource.data.addedBy == request.auth.uid
          && request.resource.data.addedAt == request.time
          && (
            (request.resource.data.amount > 0 && request.resource.data.voidOf == null)
            || (
              request.resource.data.amount < 0
              && request.resource.data.voidOf is string
              && chargeId == "void-" + request.resource.data.voidOf
              && get(/databases/$(database)/documents/bookings/$(bookingId)/charges/$(request.resource.data.voidOf)).data.amount == -request.resource.data.amount
            )
          );
        allow update, delete: if false;
      }
    }

    // Per W1.4 / decision #49 / audit S2.3: anonymized booking audit
    // records written by /api/members/delete-account. Staff can read
    // for accounting / RA 11862 compliance; clients cannot write or
    // read; server-side only.
    match /bookings/audit/records/{auditId} {
      allow read: if isStaff();
      allow write: if false;
    }

    match /financeIntegrityRepairs/{repairId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    match /guests/{userId} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == userId);
      allow create, update: if isAdmin() || (signedIn() && request.auth.uid == userId);
      allow delete: if isAdmin();
    }

    match /members/{userId} {
      allow read: if isStaff() || (signedIn() && request.auth.uid == userId);
      allow create: if false;
      allow update: if isStaff()
        || (
          signedIn()
          && request.auth.uid == userId
          && request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["fullName", "phone", "photoUrl", "updatedAt"])
        );
      allow delete: if isAdmin() || (signedIn() && request.auth.uid == userId);

      match /pointsHistory/{entryId} {
        allow read: if isStaff() || (signedIn() && request.auth.uid == userId);
        allow create: if isStaff();
        allow update, delete: if false;
      }
    }

    match /settings/{documentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /corporateInquiries/{inquiryId} {
      allow read, update, delete: if isStaff();
      allow create: if isStaff();
    }

    match /corporateInvoices/{invoiceId} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(["companyName", "bookingIds", "bookingRefs", "amount", "status", "issuedAt", "issuedBy", "paidAt", "paidBy"])
        && request.resource.data.companyName is string
        && request.resource.data.bookingIds is list
        && request.resource.data.bookingRefs is list
        && request.resource.data.amount is number
        && request.resource.data.amount > 0
        && request.resource.data.status == "issued"
        && request.resource.data.issuedAt == request.time
        && request.resource.data.issuedBy == request.auth.uid
        && request.resource.data.paidAt == null
        && request.resource.data.paidBy == null;
      allow update: if isStaff()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(["status", "paidAt", "paidBy"])
        && resource.data.status == "issued"
        && request.resource.data.status == "paid"
        && request.resource.data.paidAt == request.time
        && request.resource.data.paidBy == request.auth.uid;
      allow delete: if false;
    }

    match /contactInquiries/{inquiryId} {
      allow read, update, delete: if isStaff();
      allow create: if isStaff();
    }

    match /dailyCloses/{dateStr} {
      allow read: if isStaff();
      allow create: if isStaff()
        && request.resource.data.keys().hasOnly(["dateStr", "closedAt", "closedBy", "recordedNet", "countedNet", "variance", "notes"])
        && request.resource.data.dateStr == dateStr
        && request.resource.data.closedAt == request.time
        && request.resource.data.closedBy is string
        && request.resource.data.recordedNet is map
        && request.resource.data.countedNet is map
        && request.resource.data.variance is map
        && request.resource.data.notes is string;
      allow update, delete: if false;
    }

    // Per BI-08 (booking-intercom audit 2026-07-06): the
    // previous `allow read: if true` on both collections let
    // any anonymous visitor dump every voucher code, discount
    // value, usage cap, corporate access code, company name,
    // and negotiated `ratePerRoomType` via a single collection
    // query. The point of `/api/validate/*` (per
    // `plan/docs/GOTCHAS.md` "never expose full voucher or
    // code documents to the client") is to expose only the
    // minimum data needed for validation — the API endpoint
    // returns discount type/value (vouchers) or rate map
    // (corporate codes), never the raw document. Tightening
    // the rule to staff-only is safe because the guest-app
    // code never reads these collections client-side (the
    // API is the only sanctioned path). Admin staff reads
    // them via authenticated sessions.
    match /corporateCodes/{code} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /vouchers/{voucherId} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    match /intercoms/{roomId} {
      allow read, create, update: if true;
      allow delete: if isStaff();

      match /messages/{messageId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly([
            "text",
            "sender",
            "guestName",
            "timestamp",
            "isRead",
            "isQuickRequest",
            "isStoreOrder",
            "orderRef",
            "isEarlyCheckInRequest",
            "currentStayId"
          ])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 1000
          && request.resource.data.sender in ["guest", "front-desk"]
          && request.resource.data.guestName is string
          && request.resource.data.guestName.size() <= 120
          && request.resource.data.timestamp == request.time
          && (!("currentStayId" in request.resource.data.keys()) || request.resource.data.currentStayId == null || request.resource.data.currentStayId is string);
        allow update: if isStaff()
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(["isRead"]);
        allow delete: if isStaff();
      }
    }

    match /calls/{roomId}/{document=**} {
      allow read, write: if true;
    }

    match /storeItems/{itemId} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /storeOrders/{orderId} {
      allow read, update: if isStaff();
      allow create: if false;
      allow delete: if isAdmin();
    }
    // ── collectionGroup rules ──────────────────────────────────────────────
    // Firestore requires explicit collectionGroup rules for cross-document
    // queries (collectionGroup(db, "charges") / "payments"). The nested
    // document rules above cover single-document reads but not group queries.

    match /{path=**}/charges/{chargeId} {
      allow read: if isStaff();
      allow update, delete: if false;
    }

    match /{path=**}/payments/{paymentId} {
      allow read: if isStaff();
      allow update, delete: if false;
    }
  }
}
