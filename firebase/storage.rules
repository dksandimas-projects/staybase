rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn() && request.auth.token.role in ["front-desk", "admin"];
    }

    match /rooms/{roomId}/{fileName} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /bookings/{bookingId}/payment-proof/{fileName} {
      allow read: if isStaff();
      allow write: if true;
    }

    match /bookings/{bookingId}/discount-id/{fileName} {
      allow read: if isStaff();
      allow write: if true;
    }

    match /bookings/{bookingId}/guest-id/{fileName} {
      allow read, write: if isStaff();
    }

    match /settings/website-content/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /settings/notification-sound/{fileName} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /assets/branding/{fileName} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /store/{itemId}/{fileName} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
