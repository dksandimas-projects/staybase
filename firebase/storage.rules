rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    function signedIn() {
      return request.auth != null;
    }

    function isStaff() {
      return signedIn() && request.auth.token.role in ["front-desk", "admin"];
    }

    match /rooms/{roomId}/{fileName} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Per W3.5 / `plan/features/SETTINGS.md §Room Types`: photos are
    // stored on the room type, not the individual room. Public read
    // (guests need to render room cards / detail / featured rooms);
    // staff-only write (admin manages photos in Settings).
    match /room-types/{typeValue}/{fileName} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /bookings/{bookingId}/payment-proof/{fileName} {
      allow read: if isStaff();
      allow get: if true;
      allow write: if true;
    }

    match /bookings/{bookingId}/discount-id/{fileName} {
      allow read: if isStaff();
      allow get: if true;
      allow write: if true;
    }

    match /bookings/{bookingId}/guest-id/{fileName} {
      allow read, write: if isStaff();
    }

    match /settings/website-content/{allPaths=**} {
      allow read: if true;
      allow write: if signedIn() && request.auth.token.role == "admin";
    }

    match /settings/notification-sound/{fileName} {
      allow read: if isStaff();
      allow write: if isStaff();
    }

    // Per `plan/features/SETTINGS.md §Branding`: hero photos, hero
    // copy, and logo overrides are uploaded to Firebase Storage at
    // `assets/branding/{key-as-path}/{timestamp}-{filename}`. The
    // `{allPaths=**}` recursive wildcard is required because the
    // upload path is dynamic: each branding key (e.g. "homepage.
    // heroPhotoUrl") becomes a nested folder, so the rule must
    // match the full subtree, not just a single `fileName` segment.
    // Public read — the guest app already serves these URLs via
    // `usePublicSiteContent`. Staff-only write — the admin uploads
    // from Settings → Branding.
    match /assets/branding/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Search/social preview images uploaded from Settings → SEO & Search.
    // Public read is required by social crawlers; staff-only write keeps
    // the deploy-facing asset controlled by authenticated hotel users.
    match /assets/seo/{allPaths=**} {
      allow read: if true;
      allow write: if isStaff();
    }

    // Per `plan/features/SETTINGS.md §Payment Methods`: QR codes for
    // each booking payment method. Uploaded to Firebase Storage at
    // `assets/payment-methods/{method}/{timestamp}-{filename}` by
    // the admin from Settings → Payment Methods. Public read —
    // the guest booking page renders the QR inline. Staff-only
    // write. The `{method}` segment scopes the path so deleting one
    // method's QR (via `listAll` + `deleteObject`) cannot
    // accidentally touch another method's object.
    match /assets/payment-methods/{method}/{fileName} {
      allow read: if true;
      allow write: if isStaff();
    }

    match /store-items/{itemId}/{fileName} {
      allow read: if true;
      allow write: if isStaff();
    }

    // In-room store: GCash payment proof uploads from guests.
    // Per W4.5 decision and STORE-GUEST.md §Checkout, the path uses
    // roomNumber (matching the existing client upload path in
    // guest-app/src/pages/IntercomPage.tsx).
    match /store-orders/{roomNumber}/payment-proof/{fileName} {
      allow read: if isStaff();
      allow get: if true;
      allow write: if true;
    }
  }
}
