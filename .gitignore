# Git worktrees checked out inside the repo (see scripts/docs-audit.mjs SKIP_DIRS).
# Without this a stray `git add -A` commits another branch's entire checkout as an
# embedded repository — which happened on 2026-08-02.
.worktrees/

# Local runtime / scratch dirs produced by local agent runs and one-off dev
# tooling. Never ship them in commits — keep the working tree clean.
#   .hermes/  — local planning scratch from the agent runtime
#   output/   — local build artifacts (carousel, PDF generation) that the
#               admin-app preview tools drop here
#   outputs/  — run-scoped agent outputs (uuid-keyed subdirs)
#   tmp/      — local scratch space for one-off scripts
.hermes/
output/
outputs/
tmp/
