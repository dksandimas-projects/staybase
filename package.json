{
  "name": "spark-inn",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "guest-app",
    "admin-app",
    "shared"
  ],
  "scripts": {
    "prepare": "command -v husky >/dev/null 2>&1 && husky || true",
    "dev:guest": "npm run dev:vercel -w guest-app",
    "dev:admin": "npm run dev -w admin-app",
    "build:guest": "npm run build -w guest-app",
    "build:admin": "npm run build -w admin-app",
    "preview:guest": "npm run preview -w guest-app",
    "preview:admin": "npm run preview -w admin-app",
    "typecheck": "npm run typecheck -w guest-app && npm run typecheck -w admin-app",
    "test": "npm run test -w shared && npm run test:api -w guest-app && npm run test -w admin-app",
    "test:shared": "npm run test -w shared",
    "test:guest:api": "npm run test:api -w guest-app",
    "check:api-bundle": "node scripts/check-api-bundle.mjs",
    "test:rules": "firebase emulators:exec --only firestore --project spark-inn-rules-test \"vitest run --config vitest.rules.config.ts\"",
    "preflight": "node scripts/preflight.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "@types/node": "^22.10.2",
    "dotenv": "^17.4.2",
    "firebase": "^11.10.0",
    "firebase-tools": "^13.29.1",
    "husky": "^9.1.7",
    "vitest": "^4.1.9"
  }
}
