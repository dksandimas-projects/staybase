# AI-BROWSER-QA (2026-10-23) — Playwright configuration.
#
# COPY THIS FILE to `e2e/.qa.env.local` and fill in the values. That file is
# GITIGNORED and must never be committed. The suite also reads these
# variables from the process environment, so a CI runner can export them
# instead.
#
# NEVER commit a password. NEVER paste a password into a report, a trace
# or a chat message.

# ---------------------------------------------------------------------------
# Targets (the defaults are production)
# ---------------------------------------------------------------------------
QA_GUEST_BASE_URL=https://www.sparkinnbohol.com
QA_ADMIN_BASE_URL=https://admin.sparkinnbohol.com

# ---------------------------------------------------------------------------
# Staff identities — the dedicated QA bots. Their actual role and enrollment
# state were verified against production on 2026-10-23 (Auth custom claim +
# Firestore role + member doc); the values below are the identities, not
# guesses.
# ---------------------------------------------------------------------------

# adminbot@gmail.com — Auth claim role: "admin"
QA_ADMIN_EMAIL=adminbot@gmail.com
QA_ADMIN_PASSWORD=

# frontdeskbot@gmail.com — Auth claim role: "front-desk"
QA_FRONTDESK_EMAIL=frontdeskbot@gmail.com
QA_FRONTDESK_PASSWORD=

# memberbot@gmail.com — rewards member SR-00001, isMember true, 13 points
QA_MEMBER_EMAIL=memberbot@gmail.com
QA_MEMBER_PASSWORD=

# Member B — the controlled plus-aliased QA inbox already in production
# ("QA-TEST Unverified", SR-00002, email not verified).
QA_MEMBERB_EMAIL=qa.a2.unverified+sparkinn.dev@gmail.com
QA_MEMBERB_PASSWORD=

# ---------------------------------------------------------------------------
# QA test-run tracking
# ---------------------------------------------------------------------------
# Every booking / store order created during a pass should carry this run id
# so "every record I created" is a Firestore query rather than a promise.
# Create one as an admin:
#   POST https://www.sparkinnbohol.com/api/test-runs/create
#   { "name": "AI-BROWSER-QA 2026-10-23", "environment": "production",
#     "durationMinutes": 240 }
# and put the returned run id here.
QA_TEST_RUN_ID=
QA_TEST_RUN_NAME=AI-BROWSER-QA 2026-10-23

# ---------------------------------------------------------------------------
# Turnstile
# ---------------------------------------------------------------------------
# Every public guest write endpoint is gated by Cloudflare Turnstile, and
# production uses a REAL site key, so the widget must genuinely complete.
# The QA host could not reach the Cloudflare challenge platform on
# 2026-10-23, so no token could be issued and every guest-write scenario
# was blocked. Set this to "false" only once a token can be obtained.
QA_TURNSTILE_BYPASS=true
